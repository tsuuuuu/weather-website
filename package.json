{
    "name": "weather-website",
    "version": "2.0.0",
    "description": "Hayashi Weather: a fast, key-free weather forecast app built with React",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tsuuuuu/weather-website.git"
    },
    "author": "Tsuyoshi",
    "license": "ISC",
    "dependencies": {
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.28.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.1.6",
        "@types/react-dom": "^19.1.5",
        "@vitejs/plugin-react": "^4.5.0",
        "eslint": "^9.28.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^16.2.0",
        "jsdom": "^26.1.0",
        "prettier": "^3.5.3",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.33.0",
        "vite": "^6.3.5",
        "vitest": "^4.1.12"
    }
}
