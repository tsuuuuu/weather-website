<div class="search-form">
    <form id="search-form">
        <input id="search" type="search" required />
        <label for="search">Localização</label>
        <button class="btn-search effect" type="submit">
            <div class="insider"></div>Buscar <i class="fa-solid fa-magnifying-glass"></i>
        </button>
        <button id="my-location" class="btn-search effect" type="button">
            <div class="insider"></div>Minha localização <i class="fa-solid fa-map-location-dot"></i>
        </button>
    </form>
</div>

<pre id="message">Insira a localização e clique em "buscar".</pre>
<div id="loader" hidden>
    <img id="loading" src="/img/weather.gif" alt="Carregando" />
</div>

<div>
    <div id="flip-card" class="flip-card" hidden>
        <div class="flip-card-inner">
            <div class="flip-card-front">
                <img id="weather-icon" alt="" />
                <div class="temp">
                    <p class="temperature">Mín</p>
                    <p id="min" class="temperature"></p>
                </div>
                <div class="temp">
                    <p class="temperature">Máx</p>
                    <p id="max" class="temperature"></p>
                </div>
            </div>
            <div class="flip-card-back">
                <pre id="forecast"></pre>
            </div>
        </div>
    </div>
    <div id="next-days" class="next-days" hidden></div>
</div>

<template id="day-template">
    <div class="day">
        <p class="day-date"></p>
        <p class="day-weekday"></p>
        <img class="day-icon" alt="" />
        <p class="day-min"></p>
        <p class="day-max"></p>
    </div>
</template>
